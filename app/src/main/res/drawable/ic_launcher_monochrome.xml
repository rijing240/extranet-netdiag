<?xml version="1.0" encoding="utf-8"?>
<!--
  Themed icons, for launchers that recolour an app's mark to match the wallpaper.

  Same geometry, one colour. The platform takes this layer, strips the colour out of it and
  paints it with the tone the user chose, so the green wave and the ink parts unavoidably become
  one flat shape. A solid silhouette of the dial and its waves is the honest version to hand it:
  the network reading survives, the colour does not, and the icon still looks deliberate beside
  the system's own instead of half-tinted.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:pathData="M 26,54 A 28 28 0 1 1 82,54 A 28 28 0 1 1 26,54"
        android:strokeColor="#000000"
        android:strokeWidth="5"
        android:strokeLineCap="round" />
    <path
        android:pathData="M 54,45 A 9 9 0 0 1 63,54"
        android:strokeColor="#000000"
        android:strokeWidth="5"
        android:strokeLineCap="round" />
    <path
        android:pathData="M 54,37 A 17 17 0 0 1 71,54"
        android:strokeColor="#000000"
        android:strokeWidth="5"
        android:strokeLineCap="round" />
    <path
        android:fillColor="#000000"
        android:pathData="M 50.6,54 A 3.4 3.4 0 1 1 57.4,54 A 3.4 3.4 0 1 1 50.6,54 Z" />
</vector>
