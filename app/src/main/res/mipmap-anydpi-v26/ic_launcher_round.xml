<?xml version="1.0" encoding="utf-8"?>
<!--
  The same icon for launchers that ask for a round one.

  It is the same artwork rather than a redrawn round version: the mark already lives inside the
  circle a round mask keeps, so a separate drawing would only be a chance for the two to disagree.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
