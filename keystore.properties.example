# The release signing key's location and passwords, for `app/build.gradle.kts`.
#
# Copy this file to `keystore.properties` (which is git-ignored) and fill it in, or let the
# release workflow write it from repository secrets. Without it, release builds come out
# unsigned and everything else still works.
#
# Making the key, once, and keeping it forever:
#
#   keytool -genkeypair -v \
#     -keystore keystore/release.jks \
#     -alias extranet \
#     -keyalg RSA -keysize 4096 -validity 10000 \
#     -dname "CN=extranet, O=extranet, C=KE"
#
# Then back it up somewhere you will still have in five years - password manager, offline drive,
# or both - because an Android update has to be signed with this exact key and nothing else, and
# there is no recovery path if it is lost: every phone that installed the app could never update
# it again. Never commit it, and never put it in a chat message or a screenshot.

storeFile=keystore/release.jks
storePassword=change-me
keyAlias=extranet
keyPassword=change-me
